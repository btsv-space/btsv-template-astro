---
import '../styles/global.css';
import { site } from '../site.config';
import { getCollection } from 'astro:content';

const { title, description } = Astro.props;

const navPages = (await getCollection('posts', ({ data }) => data.page)).map((p) => ({
	slug: p.data.slug || p.id,
	title: p.data.title
}));
---

<!doctype html>
<html lang={site.lang}>
	<head>
		<script>
			(function () {
				var m = window.matchMedia("(prefers-color-scheme: dark)");
				if (m.matches) document.documentElement.classList.add("dark");
				m.addEventListener("change", function (e) {
					document.documentElement.classList.toggle("dark", e.matches);
				});
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f7f7" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
		<title>{title && title !== site.name ? `${title} — ${site.name}` : site.name}</title>
		<meta name="description" content={description || site.description} />
		<link rel="icon" type="image/svg+xml" href={site.faviconSvg} />
	</head>
	<body>
		<header class="flex items-center justify-between max-w-4xl mx-auto px-4 py-4">
			<a href="/" class="text-lg font-semibold no-underline text-foreground hover:opacity-80">{site.name}</a>
			<nav class="flex items-center gap-4 text-sm">
				{navPages.map((page) => (
					<a href={`/${page.slug}`} class="text-muted-foreground no-underline hover:text-foreground">{page.title}</a>
				))}
			</nav>
		</header>
		<main class="max-w-4xl mx-auto px-4 py-6">
			<slot />
		</main>
		<footer class="max-w-4xl mx-auto px-4 py-8 text-center text-sm text-muted-foreground">
			<p>・・・</p>
			<p set:html={site.footer} />
		</footer>
	</body>
</html>
