---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostArticle from '../../components/PostArticle.astro';
import { site } from '../../site.config';

const PAGE_SIZE = 10;

export async function getStaticPaths() {
	const allPosts = await getCollection('posts', ({ data }) => {
		if (data.page) return false;
		return import.meta.env.PROD ? !data.draft : true;
	});

	allPosts.sort((a, b) => {
		const aTime = a.data.datePublished?.getTime() ?? 0;
		const bTime = b.data.datePublished?.getTime() ?? 0;
		return bTime - aTime;
	});

	const tagMap = new Map<string, typeof allPosts>();
	for (const post of allPosts) {
		for (const tag of post.data.tags) {
			if (!tagMap.has(tag)) tagMap.set(tag, []);
			tagMap.get(tag)!.push(post);
		}
	}

	return Array.from(tagMap.entries()).map(([tag, posts]) => ({
		params: { tag },
		props: { posts, tag }
	}));
}

const { posts, tag } = Astro.props;
const displayPosts = posts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const hasMore = totalPages > 1;
---

<Base title={`#${tag} — ${site.name}`} description={`Posts tagged ${tag}`}>
	<h1 class="text-2xl font-bold mb-8">#{tag}</h1>
	{
		posts.length === 0 ? (
			<p class="text-muted-foreground">No posts with this tag.</p>
		) : (
			<div class="flex flex-col gap-12">
				{displayPosts.map((post) => (
					<PostArticle post={post} titleAsLink={true} clamp>
						<a href={`/${post.data.slug || post.id}`} class="btn-secondary rounded-full text-sm mt-6 inline-flex no-underline">
							Read more →
						</a>
					</PostArticle>
				))}
			</div>
		)
	}
	{hasMore && (
		<nav class="flex justify-center gap-4 mt-12 text-sm">
			<a href={`/tags/${tag}/page/2/`} class="btn-secondary rounded-full px-4 py-2 no-underline">Older posts →</a>
		</nav>
	)}
</Base>
