---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostArticle from '../components/PostArticle.astro';
import { site } from '../site.config';

const PAGE_SIZE = 10;

const allPosts = await getCollection('posts', ({ data }) => {
	if (data.page) return false;
	return import.meta.env.PROD ? !data.draft : true;
});

allPosts.sort((a, b) => {
	const aTime = a.data.datePublished?.getTime() ?? 0;
	const bTime = b.data.datePublished?.getTime() ?? 0;
	return bTime - aTime;
});

const posts = allPosts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
const hasMore = totalPages > 1;
---

<Base title={site.name}>
	{
		posts.length === 0 ? (
			<p class="text-muted-foreground">No posts yet.</p>
		) : (
			<div class="flex flex-col gap-12">
				{posts.map((post) => (
					<PostArticle post={post} titleAsLink={true} clamp>
						<a href={`/${post.data.slug || post.id}`} class="btn-secondary rounded-full text-sm mt-6 inline-flex no-underline">
							Read more →
						</a>
					</PostArticle>
				))}
			</div>
		)
	}
	{hasMore && (
		<nav class="flex justify-center gap-4 mt-12 text-sm">
			<a href="/page/2/" class="btn-secondary rounded-full px-4 py-2 no-underline">Older posts →</a>
		</nav>
	)}
</Base>
